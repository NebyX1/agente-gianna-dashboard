GIANNA_HOST=127.0.0.1
GIANNA_PORT=7860
GIANNA_PROFILE=idl-tickets
# El almacenamiento se resuelve al directorio de datos del usuario si no se configura.
# GIANNA_DATA_DIR=D:/Datos/Gianna
GIANNA_TICKETS_API=http://localhost:5000
GIANNA_TICKETS_WEB=http://localhost:5173
GIANNA_INTERPRETER_BACKEND=cloud
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
GIANNA_ACTIVATION_THRESHOLD=0.45
GIANNA_CATALOG_THRESHOLD=0.70
GIANNA_CLOUD_URL=https://ollama.com
GIANNA_CLOUD_TIMEOUT=45
GIANNA_STT_DEVICE=cuda
GIANNA_STT_COMPUTE_TYPE=int8_float16
GIANNA_PIPER_PORT=5001
GIANNA_TRANSPORT_SAMPLE_RATE=24000
GIANNA_IDLE_SECONDS=120
GIANNA_CONFIRMATION_SECONDS=120
GIANNA_STT_GRACE_SECONDS=15
GIANNA_MAX_TURN_SECONDS=90
GIANNA_MAX_EVENTS=256
GIANNA_MAX_TOOL_CALLS=12
GIANNA_VAD_CONFIDENCE=0.60
GIANNA_VAD_START_SECONDS=0.2
GIANNA_VAD_STOP_SECONDS=0.8
GIANNA_VAD_MIN_VOLUME=0.10
GIANNA_RAW_AUDIO=false
GIANNA_DIAGNOSTICS=false
GIANNA_TURN_SETTLE_SECONDS=0.4
GIANNA_TURN_STOP_SECONDS=2.0
